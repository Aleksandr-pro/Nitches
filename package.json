{
  "name": "nitches-horizon",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Мобильная фестивальная гоночная аркада с открытым миром в духе Forza Horizon",
  "scripts": {
    "dev": "vite",
    "assets:check": "node scripts/check-lfs-assets.mjs",
    "assets:check-all": "node scripts/check-lfs-assets.mjs --all",
    "assets:check-dist": "node scripts/check-lfs-assets.mjs --dist",
    "assets:fixture": "node scripts/generate-pipeline-smoke-glb.mjs",
    "test": "node --test tests/resources/*.test.mjs",
    "test:resources": "node --test tests/resources/*.test.mjs",
    "cloud:tree": "node scripts/generate-cloud-prototype-tree.mjs",
    "cloud:catalog": "node scripts/build-cloud-catalog.mjs --clean --report .cloud-assets/publishing.json",
    "cloud:validate": "node scripts/validate-cloud-catalog.mjs --bundle .cloud-assets/staging",
    "cloud:bundle": "npm run cloud:catalog && npm run cloud:validate",
    "prebuild": "npm run assets:check",
    "build": "vite build",
    "postbuild": "npm run assets:check-dist",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run build && cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "vite": "^7.1.0"
  }
}
