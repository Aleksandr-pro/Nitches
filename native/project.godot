; Engine configuration file.
; Nitches Horizon Native — a real Godot game project.
; 0.2.47 adds the second world: the 4x4 km Desert ("Пустынный каньон")
; with its own generated data set (native/data/desert_native.json,
; scripts/generate_desert_world.py) next to RichTown.
; There is deliberately no HTML, JavaScript, Capacitor or WebView runtime in
; this directory. Android receives a native Godot ARM64 executable/APK.

config_version=5

[application]

config/name="Nitches Horizon Native"
config/description="Native open-world festival racing prototype built with Godot 4."
config/version="0.3.30-native-alpha"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.003, 0.008, 0.016, 1)
boot_splash/image="res://assets/ui/boot_splash_richtown.jpg"
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/show_image=true
boot_splash/min_display_time=0

[debug]

gdscript/warnings/unsafe_property_access=true
gdscript/warnings/unsafe_method_access=true
gdscript/warnings/unsafe_cast=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=9.8
common/physics_interpolation=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=true
textures/default_filters/anisotropic_filtering_level=4
textures/vram_compression/import_etc2_astc=true
textures/lossless_compression/force_png=false
environment/defaults/default_clear_color=Color(0.35, 0.62, 0.86, 1)
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
shadows/positional_shadow/atlas_size=2048
shadows/positional_shadow/atlas_size.mobile=1024
shadows/positional_shadow/atlas_quadrant_0_subdiv=2
shadows/positional_shadow/atlas_quadrant_1_subdiv=2
shadows/positional_shadow/atlas_quadrant_2_subdiv=3
shadows/positional_shadow/atlas_quadrant_3_subdiv=4
scaling_3d/mode=1
scaling_3d/scale=1.0
limits/spatial_indexer/threaded_cull_minimum_instances=128
