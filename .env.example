# Public, read-only base URL for versioned game assets.
# Leave empty to disable optional cloud content; bundled APK content still works.
# Example after Cloudflare R2 is configured:
# VITE_ASSET_CDN_BASE_URL=https://assets.example.com
VITE_ASSET_CDN_BASE_URL=

# Never put Cloudflare/R2 API keys, access keys, or tokens in this file.
# Anything named VITE_* is compiled into the browser/Android client.
